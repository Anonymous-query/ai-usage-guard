#!/usr/bin/env python3
"""Entry point installed as /usr/local/bin/intern-ai-guard."""
import os
import sys

PKG = "/usr/local/lib/intern-ai-guard"
sys.path.insert(0, PKG)

if __name__ == "__main__":
    # uninstall is a shell operation; delegate to the installed script.
    if len(sys.argv) > 1 and sys.argv[1] == "uninstall":
        os.execv("/usr/local/lib/intern-ai-guard/uninstall.sh",
                 ["/usr/local/lib/intern-ai-guard/uninstall.sh"] + sys.argv[2:])
    import cli
    sys.exit(cli.main())
